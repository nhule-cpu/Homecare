# Sao chép thành .env và điền giá trị thật. KHÔNG commit file .env.
NODE_ENV=development

# PostgreSQL 16 + PostGIS (infra/docker-compose.yml)
# Ứng dụng dùng role app_user (không phải superuser); migration dùng role migrator.
DATABASE_URL=postgresql://app_user:app_user_dev@localhost:5432/homecare
MIGRATOR_DATABASE_URL=postgresql://migrator:migrator_dev@localhost:5432/homecare

# Redis 7 (cache, hàng đợi BullMQ, phiên đăng nhập)
REDIS_URL=redis://localhost:6379

# Object storage S3-compatible (MinIO khi chạy local)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=homecare
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Mã hóa dữ liệu sức khỏe (AES-256-GCM, 32 byte dạng base64). Tạo bằng: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# HMAC-SHA256 cho phone_hash. Tạo bằng: openssl rand -base64 32
PHONE_HMAC_KEY=
# Bí mật ký phiên đăng nhập. Tạo bằng: openssl rand -base64 48
SESSION_SECRET=

# Bản đồ
MAP_PROVIDER=fake
VIETMAP_API_KEY=
TOMTOM_API_KEY=

# Cổng chạy local
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
